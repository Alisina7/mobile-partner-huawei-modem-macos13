<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Mobile Partner</title>
    <organization>com.mobilepartner.replacement</organization>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.mobilepartner.replacement.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.mobilepartner.replacement.pkg" visible="false">
        <pkg-ref id="com.mobilepartner.replacement.pkg"/>
    </choice>
    <pkg-ref id="com.mobilepartner.replacement.pkg" version="1.0" onConclusion="none">MobilePartner.pkg</pkg-ref>
</installer-gui-script>
